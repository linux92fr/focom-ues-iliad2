# Supabase public frontend configuration
# Copy this file to .env.local and fill in your project values.

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ONLYOFFICE
# URL publique du service Node.js qui signe la configuration (sans slash final).
VITE_ONLYOFFICE_API_URL=https://api.focomues-iliad.fr
# URL publique d'ONLYOFFICE Docs.
VITE_ONLYOFFICE_DOCUMENT_SERVER_URL=https://docs.focomues-iliad.fr

# Préfixe des routes admin (défaut: "admin"). Changer en production pour obscurcir /admin.
# Exemple: VITE_ADMIN_PREFIX=ges-fo
VITE_ADMIN_PREFIX=admin
