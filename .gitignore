```gitignore
# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn-cache/

# Build outputs
dist/
build/
coverage/
.nyc_output/
.eslintcache

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.env
.env.local
.env.*
.env.local.*
.venv/
ENV/
.env.bak/
venv.bak/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment specific
.env.local
.env.*.local

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# TypeScript
*.tsbuildinfo
```